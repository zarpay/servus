source "https://rubygems.org"

# =============================================================================
# Servus demo harness
# =============================================================================
#
# The whole point of this app: an exhaustive integration harness for the servus
# gem, exercising every public feature in realistic Rails usage. Path-pinned to
# the in-tree gem source so changes in `../gem` are picked up immediately by
# `bundle exec rspec` here.
#
# If a change to the gem regresses any documented behaviour, this suite breaks.
gem "servus", path: "../gem"

gem "rails", "~> 8.1.3"
gem "propshaft"
gem "sqlite3", ">= 2.1"
gem "puma", ">= 5.0"

gem "tzinfo-data", platforms: %i[ windows jruby ]
gem "bootsnap", require: false

group :development, :test do
  gem "debug", platforms: %i[ mri windows ], require: "debug/prelude"

  # The demo is spec-driven; every feature is proven by an example.
  gem "rspec-rails"
  gem "factory_bot_rails"
end

group :test do
  gem "simplecov", require: false
end

group :development do
  gem "web-console"
end
